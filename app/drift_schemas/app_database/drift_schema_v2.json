  "fixed_sql": [
    {
      "name": "decks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"decks\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "cards",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"cards\" (\"id\" TEXT NOT NULL, \"deck_id\" TEXT NOT NULL REFERENCES decks (id) ON DELETE CASCADE, \"front\" TEXT NOT NULL, \"back\" TEXT NOT NULL, \"card_key\" TEXT NOT NULL, \"source\" TEXT NOT NULL CHECK(source IN ('manual', 'import')), \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "reviews",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"reviews\" (\"id\" TEXT NOT NULL, \"card_id\" TEXT NOT NULL REFERENCES cards (id) ON DELETE CASCADE, \"rating\" TEXT NOT NULL CHECK(rating IN ('again', 'good')), \"reviewed_at\" INTEGER NOT NULL, \"duration_ms\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "card_states",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"card_states\" (\"card_id\" TEXT NOT NULL REFERENCES cards (id) ON DELETE CASCADE, \"stability\" REAL NOT NULL, \"difficulty\" REAL NOT NULL, \"last_review\" INTEGER NOT NULL, \"due\" INTEGER NOT NULL, PRIMARY KEY (\"card_id\"));"
        }
      ]
    },
    {
      "name": "cards_deck_id_card_key",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX cards_deck_id_card_key ON cards (deck_id, card_key)"
        }
      ]
    }
  ]
