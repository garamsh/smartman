      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"decks\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"visibility\" TEXT NOT NULL DEFAULT 'private' CHECK(visibility IN ('private', 'public')), \"published_at\" TEXT NULL, \"description\" TEXT NULL, \"icon\" TEXT NULL, \"color\" TEXT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, \"dirty\" INTEGER NOT NULL DEFAULT 1 CHECK (\"dirty\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
