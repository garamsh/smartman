          "sql": "CREATE TABLE IF NOT EXISTS \"reviews\" (\"id\" TEXT NOT NULL, \"card_id\" TEXT NOT NULL REFERENCES cards (id) ON DELETE CASCADE, \"rating\" TEXT NOT NULL CHECK(rating IN ('again', 'good')), \"reviewed_at\" TEXT NOT NULL, \"duration_ms\" INTEGER NOT NULL, \"fuzz_factor\" REAL NULL CHECK(fuzz_factor >= 0 AND fuzz_factor < 1), \"updated_at\" TEXT NOT NULL, \"dirty\" INTEGER NOT NULL DEFAULT 1 CHECK (\"dirty\" IN (0, 1)), PRIMARY KEY (\"id\"));"
